      </link>
    </model>

    <!-- Dense, asymmetric features in the initial camera view.  These are
         visual-only so they improve stereo initialization without changing
         collision geometry or providing a non-visual navigation signal. -->
    <model name="start_feature_board">
      <static>true</static>
      <link name="board">
        <visual name="background">
          <pose>-0.072 -3.0 1.15 0 0 0</pose>
          <geometry><box><size>0.018 3.2 1.9</size></box></geometry>
          <material><ambient>0.025 0.025 0.025 1</ambient><diffuse>0.025 0.025 0.025 1</diffuse></material>
