        <visual name="panel_south_green"><pose>2.8 -4.925 1.30 0 0 0</pose><geometry><box><size>0.85 0.025 0.65</size></box></geometry><material><ambient>0.04 0.56 0.18 1</ambient><diffuse>0.04 0.56 0.18 1</diffuse></material></visual>
        <visual name="panel_south_black_1"><pose>2.60 -4.908 1.43 0 0 0</pose><geometry><box><size>0.22 0.025 0.16</size></box></geometry><material><ambient>0.01 0.01 0.01 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse></material></visual>
        <visual name="panel_south_white_1"><pose>3.04 -4.908 1.17 0 0 0</pose><geometry><box><size>0.15 0.025 0.28</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <visual name="panel_west_orange"><pose>-5.925 1.8 1.35 0 0 0</pose><geometry><box><size>0.025 0.72 0.72</size></box></geometry><material><ambient>0.88 0.32 0.04 1</ambient><diffuse>0.88 0.32 0.04 1</diffuse></material></visual>
