<?xml version="1.0"?>
<sdf version="1.9">
  <world name="indoor_stereo">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.08 0.10 0.14 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>100</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.4 0.2 -1.0</direction>
    </light>

    <model name="indoor_architecture">
      <static>true</static>
      <link name="architecture">
        <collision name="floor_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>12 10 0.1</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>12 10 0.1</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
            <pbr>
              <metal>
                <albedo_map>../materials/textures/indoor_floor.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.95</roughness>
              </metal>
            </pbr>
          </material>
        </visual>

        <!-- Outer boundary. -->
        <collision name="north_wall_collision"><pose>0 5 1.25 0 0 0</pose><geometry><box><size>12 0.12 2.5</size></box></geometry></collision>
        <visual name="north_wall_visual"><pose>0 5 1.25 0 0 0</pose><geometry><box><size>12 0.12 2.5</size></box></geometry><material><ambient>0.72 0.76 0.82 1</ambient><diffuse>0.72 0.76 0.82 1</diffuse></material></visual>
        <collision name="south_wall_collision"><pose>0 -5 1.25 0 0 0</pose><geometry><box><size>12 0.12 2.5</size></box></geometry></collision>
        <visual name="south_wall_visual"><pose>0 -5 1.25 0 0 0</pose><geometry><box><size>12 0.12 2.5</size></box></geometry><material><ambient>0.76 0.72 0.66 1</ambient><diffuse>0.76 0.72 0.66 1</diffuse></material></visual>
        <collision name="east_wall_collision"><pose>6 0 1.25 0 0 0</pose><geometry><box><size>0.12 10 2.5</size></box></geometry></collision>
        <visual name="east_wall_visual"><pose>6 0 1.25 0 0 0</pose><geometry><box><size>0.12 10 2.5</size></box></geometry><material><ambient>0.68 0.75 0.68 1</ambient><diffuse>0.68 0.75 0.68 1</diffuse></material></visual>
        <collision name="west_wall_collision"><pose>-6 0 1.25 0 0 0</pose><geometry><box><size>0.12 10 2.5</size></box></geometry></collision>
        <visual name="west_wall_visual"><pose>-6 0 1.25 0 0 0</pose><geometry><box><size>0.12 10 2.5</size></box></geometry><material><ambient>0.72 0.68 0.75 1</ambient><diffuse>0.72 0.68 0.75 1</diffuse></material></visual>

        <!-- Internal wall x=0, with a 1.1 m door between y=-1.0 and y=0.1. -->
        <collision name="center_wall_south_collision"><pose>0 -3.0 1.25 0 0 0</pose><geometry><box><size>0.12 4.0 2.5</size></box></geometry></collision>
        <visual name="center_wall_south_visual"><pose>0 -3.0 1.25 0 0 0</pose><geometry><box><size>0.12 4.0 2.5</size></box></geometry><material><ambient>0.82 0.78 0.65 1</ambient><diffuse>0.82 0.78 0.65 1</diffuse></material></visual>
        <collision name="center_wall_north_collision"><pose>0 2.55 1.25 0 0 0</pose><geometry><box><size>0.12 4.9 2.5</size></box></geometry></collision>
        <visual name="center_wall_north_visual"><pose>0 2.55 1.25 0 0 0</pose><geometry><box><size>0.12 4.9 2.5</size></box></geometry><material><ambient>0.82 0.78 0.65 1</ambient><diffuse>0.82 0.78 0.65 1</diffuse></material></visual>

        <!-- Horizontal partition in the east half, with a 1.2 m doorway. -->
        <collision name="east_partition_west_collision"><pose>1.45 1.5 1.25 0 0 0</pose><geometry><box><size>2.9 0.12 2.5</size></box></geometry></collision>
        <visual name="east_partition_west_visual"><pose>1.45 1.5 1.25 0 0 0</pose><geometry><box><size>2.9 0.12 2.5</size></box></geometry><material><ambient>0.64 0.76 0.80 1</ambient><diffuse>0.64 0.76 0.80 1</diffuse></material></visual>
        <collision name="east_partition_east_collision"><pose>5.0 1.5 1.25 0 0 0</pose><geometry><box><size>2.0 0.12 2.5</size></box></geometry></collision>
        <visual name="east_partition_east_visual"><pose>5.0 1.5 1.25 0 0 0</pose><geometry><box><size>2.0 0.12 2.5</size></box></geometry><material><ambient>0.64 0.76 0.80 1</ambient><diffuse>0.64 0.76 0.80 1</diffuse></material></visual>

        <!-- Floor bands produce trackable, non-repeating corners without external assets. -->
        <visual name="floor_band_1"><pose>-3.5 -1.2 0.006 0 0 0.25</pose><geometry><box><size>1.6 0.06 0.012</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual>
        <visual name="floor_band_2"><pose>-1.8 3.1 0.006 0 0 -0.4</pose><geometry><box><size>1.1 0.08 0.012</size></box></geometry><material><ambient>0.16 0.26 0.55 1</ambient><diffuse>0.16 0.26 0.55 1</diffuse></material></visual>
        <visual name="floor_band_3"><pose>2.5 -3.5 0.006 0 0 0.7</pose><geometry><box><size>1.8 0.05 0.012</size></box></geometry><material><ambient>0.62 0.12 0.10 1</ambient><diffuse>0.62 0.12 0.10 1</diffuse></material></visual>
        <visual name="floor_band_4"><pose>4.5 3.4 0.006 0 0 -0.3</pose><geometry><box><size>1.3 0.07 0.012</size></box></geometry><material><ambient>0.12 0.46 0.22 1</ambient><diffuse>0.12 0.46 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- High-contrast geometric feature panels. Each panel has a unique layout. -->
    <model name="feature_panels">
      <static>true</static>
      <link name="panels">
        <visual name="panel_north_red"><pose>-4.2 4.925 1.25 0 0 0</pose><geometry><box><size>0.75 0.025 0.75</size></box></geometry><material><ambient>0.70 0.06 0.05 1</ambient><diffuse>0.70 0.06 0.05 1</diffuse></material></visual>
        <visual name="panel_north_black_1"><pose>-4.35 4.908 1.37 0 0 0</pose><geometry><box><size>0.12 0.025 0.32</size></box></geometry><material><ambient>0.01 0.01 0.01 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse></material></visual>
