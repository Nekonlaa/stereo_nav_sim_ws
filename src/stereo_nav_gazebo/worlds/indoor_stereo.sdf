        <visual name="tile_11"><pose>-0.086 -3.98 0.66 0 0 0</pose><geometry><box><size>0.010 0.31 0.13</size></box></geometry><material><ambient>0.78 0.78 0.78 1</ambient><diffuse>0.78 0.78 0.78 1</diffuse></material></visual>
