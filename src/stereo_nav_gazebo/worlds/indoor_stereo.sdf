        <visual name="panel_west_white"><pose>-5.908 1.98 1.18 0 0 0</pose><geometry><box><size>0.025 0.26 0.13</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

