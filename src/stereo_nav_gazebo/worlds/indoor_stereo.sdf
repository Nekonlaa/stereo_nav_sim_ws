    <!--
      Distributed, asymmetric floor landmarks keep pure visual odometry
      observable after the rover leaves the feature-rich spawn area.  Every
      landmark is a differently oriented two-part glyph, so the stereo pair
      sees corners at useful depths without introducing collision geometry or
      any non-visual localization signal.
    -->
    <model name="distributed_floor_features">
      <static>true</static>
      <link name="features">
        <!-- West room, south-to-north route. -->
        <visual name="w01a"><pose>-4.85 -2.35 0.007 0 0 0.31</pose><geometry><box><size>0.46 0.07 0.014</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
