<?xml version="1.0"?>
<sdf version="1.9">
  <model name="stereo_rover">
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.15 0 0 0</pose>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.130</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.240</iyy><iyz>0</iyz><izz>0.310</izz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><box><size>0.45 0.34 0.12</size></box></geometry>
        <material>
          <ambient>0.08 0.24 0.55 1</ambient>
          <diffuse>0.08 0.24 0.55 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="chassis_collision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><box><size>0.45 0.34 0.12</size></box></geometry>
      </collision>
    </link>

    <link name="left_wheel_link">
      <pose>0.05 0.19 0.08 1.57079632679 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.0021</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0038</iyy><iyz>0</iyz><izz>0.0021</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <link name="right_wheel_link">
      <pose>0.05 -0.19 0.08 1.57079632679 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.0021</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0038</iyy><iyz>0</iyz><izz>0.0021</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <link name="rear_caster_link">
      <pose>-0.17 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.000064</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000064</iyy><iyz>0</iyz><izz>0.000064</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name="rear_caster_joint" type="fixed">
      <parent>base_link</parent><child>rear_caster_link</child>
    </joint>

    <link name="camera_rig_link">
      <pose>0.16 0 0.42 0 0.1396263402 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.0008</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0008</iyy><iyz>0</iyz><izz>0.0014</izz></inertia>
      </inertial>
      <visual name="rig_visual">
        <geometry><box><size>0.06 0.18 0.055</size></box></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
      </visual>

      <sensor name="left_camera" type="camera">
        <pose>0 0.06 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/stereo/left/image_raw</topic>
        <gz_frame_id>stereo_left_optical_frame</gz_frame_id>
        <camera name="left">
          <camera_info_topic>/stereo/left/camera_info</camera_info_topic>
          <optical_frame_id>stereo_left_optical_frame</optical_frame_id>
          <horizontal_fov>1.57079632679</horizontal_fov>
          <image><width>640</width><height>480</height><format>L8</format></image>
          <clip><near>0.15</near><far>8.0</far></clip>
          <intrinsics><fx>320</fx><fy>320</fy><cx>319.5</cx><cy>239.5</cy><s>0</s></intrinsics>
          <projection><p_fx>320</p_fx><p_fy>320</p_fy><p_cx>319.5</p_cx><p_cy>239.5</p_cy><tx>0</tx><ty>0</ty></projection>
          <distortion><k1>0</k1><k2>0</k2><k3>0</k3><p1>0</p1><p2>0</p2><center>0.5 0.5</center></distortion>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </camera>
      </sensor>

      <sensor name="right_camera" type="camera">
        <pose>0 -0.06 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/stereo/right/image_raw</topic>
        <gz_frame_id>stereo_right_optical_frame</gz_frame_id>
        <camera name="right">
          <camera_info_topic>/stereo/right/camera_info</camera_info_topic>
          <optical_frame_id>stereo_right_optical_frame</optical_frame_id>
          <horizontal_fov>1.57079632679</horizontal_fov>
          <image><width>640</width><height>480</height><format>L8</format></image>
          <clip><near>0.15</near><far>8.0</far></clip>
          <intrinsics><fx>320</fx><fy>320</fy><cx>319.5</cx><cy>239.5</cy><s>0</s></intrinsics>
          <projection><p_fx>320</p_fx><p_fy>320</p_fy><p_cx>319.5</p_cx><p_cy>239.5</p_cy><tx>-38.4</tx><ty>0</ty></projection>
          <distortion><k1>0</k1><k2>0</k2><k3>0</k3><p1>0</p1><p2>0</p2><center>0.5 0.5</center></distortion>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </camera>
      </sensor>
    </link>

    <joint name="camera_rig_joint" type="fixed">
      <parent>base_link</parent><child>camera_rig_link</child>
    </joint>

    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.38</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>/model/stereo_rover/cmd_vel</topic>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>

    <!-- Actual simulated model pose for evaluation only.  DiffDrive's
         wheel-integrated odometry is intentionally left on its default,
         unbridged topic so it cannot masquerade as ground truth. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <dimensions>2</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/ground_truth/odom</odom_topic>
      <tf_topic>/ground_truth/tf_not_bridged</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>
