<?xml version="1.0"?>
<package format="3">
  <name>stereo_nav_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Fortress model, indoor world, and ROS bridge for stereo navigation.</description>
  <maintainer email="maintainer@example.com">Stereo Navigation Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>stereo_nav_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
